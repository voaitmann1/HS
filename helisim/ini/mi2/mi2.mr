helisim.initial.mainrotor
model: втулка шарнирная Mи-2
notes: несущий винт : конструктивные параметры
------------------------------------------------------------------------------------

 mr.hubtype=    0               тип втулки НВ  (0=ОШ+ГШ+ВШ, 1=ОШ+ГШ, 2=ОШ+СовмГШ(качалка), 3=ОШ(бесшарнирный));
 mr.rdirect=    0               направление вращения НВ: 0 - против ЧС; 1 - по ЧС (по оси Yнв);
 mr.z=          3       	количество лопастей НВ;
 mr.ml=         55.5      	масса лопасти, кг;              (171.3/3)
 mr.Ib0=        804.577         момент инерции лопасти отн. оси НВ, кг*м^2;
 mr.Sb0=        202.661         статический момент лопасти отн. оси НВ, кг*м;
 mr.lgsh=       102.0           разнос ГШ, мм;
 mr.lvsh=       262.0   	разнос ВШ, мм;
 mr.svsh=       -35.0    	смещение ВШ (вынос горизонтального шарнира вперед), мм;
 mr.kvz=        0.40            коэф. компенсатора взмаха;
 mr.dCxp=       0.002           поправка к коэф. профильного сопротивления;
 mr.Bkp=        0.970           коэф. концевых потерь;
 
 mr.xo= 	0.25	   	положение центра закрутки профиля (ОШ), мм 
 mr.xt=         0.25	   	положение центра тяжести профиля, мм	
 /mr.stiff3=     300000  		жесткость крутильная отн.ОШ (приведенная жесткость системы управления)	
 /mr.flapStiff=	20000		жесткость изгибная в плоскости взмаха
 mr.r_pov=  	205.0	 ~	расстояние от оси ОШ до поводка (до тяги рукава лопасти), мм
 mr.k_pov=   0   10000  27e6	 ~	жесткость системы управления линейная, кН/м (rotStiff = k_pov*r_pov*r_pov;)
 mr.f_pod=  	0.006	 +	коэф.трения в упорном подшипнике ОШ
 mr.r_pod=	140	 ~	радиус упорного подщипника ОШ, мм
 mr.sigma3=     0  8  	 ~	коэффициент демпфирования закрутки, Н*м*с2/рад2;
 mr.mlp=        9.0273259596616785946649316851008     ~  	погонная масса лопасти, кг/м; 
 mr.Iop=        0.1  	 +	погонный момент инерции лопасти отн.ОШ, кг*м^2/м;  // mr.momInerPog=	20	момент инерции погонный



АВТОМАТ ПЕРЕКОСА
             
 mr.D1=         1.56468 /1.57   передаточное отношение между продольным наклоном конуса НВ и углом отклонения АП в продольном канале
 mr.D2=        -0.08833 /0.00   передаточное отношение между поперечным наклоном конуса НВ и углом отклонения АП в поперечном канале
 mr.Rap=        0.265           радиус крепления тяг, м;
 mr.ll=         0.157           расстояние от оси ОШ до т.крепления тяги управления к поводку, м;
 mr.dpsi_cont=  25.0            угол опережения управления, градус;



