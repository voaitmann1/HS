демпфер лопасти: 
 damper=    1           1: установлены демпферы, 0: не установлены
 d.h=       147     	плечо силы на демпфере, мм;
 d.x2=      70      	коорд.x шарнира демпфера на втулке отн.оси НВ, мм;
 d.z2=      102     	коорд.z шарнира демпфера на втулке отн.оси НВ, мм;
 d.x3=      120     	коорд.x шарнира демпфера на лопасти* отн.оси НВ, мм;
 d.z3=      258     	коорд.z шарнира демпфера на лопасти* отн.оси НВ, мм;
 d.ro=      850     	плотность жидкости в демпфере, кг/м^3;
 d.mu=      0.70    	коэф. истечения жидкости в демпфере (0.65...0.75);
 d.f=       1.80     	суммарная площадь отверстий в демпфере при закрытых клапанах, мм^2;
 d.f2=      5.00     	суммарная площадь отверстий в демпфере при открытых клапанах, мм^2;
 d.dv=      20      	диаметр штока демпфера, мм;
 d.dn=      68      	диаметр цилиндра демпфера внутренний, мм;
 d.pmax=    17.0    	давление срабатывания клапана демпфера, кгс/см^2;



виброгаситель несущего винта: 
 vabsorber= 0           (мат.модель отсутствует) 1: установлен виброгаситель НВ, 0: не установлен
 vg.n=      3   	количество маятников виброгасителя
 vg.m=      8   	масса 1-го маятника, кг
 vg.h=      700 	расстояние от оси вала НВ до центра масс маятника, мм
 vg.d=      30  	диаметр роликов, мм
 vg.D=      100 	диаметр сверлений, мм
 mr.Jy=     8   	момент инерции вала(,...) и втулки НВ



испытательный стенд для несущего винта:
 s.m=       500     	масса стенда, кг;
 s.ro=      850     	плотность жидкости в демпфере стенда, кг/м^3;
 s.mu=      0.70    	коэф. истечения жидкости в демпфере стенда (0.65...0.75);
 s.dvx=     10      	диаметр штока демпфера стенда, мм;
 s.dnx=     30      	диаметр цилиндра демпфера стенда внутренний, мм;
 s.fx=      2     	суммарная площадь отверстий в демпфере стенда, мм^2;
 s.kx=      2000 	жесткость пружины стенда, Н/мм;
 s.dvz=     10      	диаметр штока демпфера стенда, мм;
 s.dnz=     30      	диаметр цилиндра демпфера стенда внутренний, мм;
 s.fz=      2       	суммарная площадь отверстий в демпфере стенда, мм^2;
 s.kz=      2000      	жесткость пружины стенда, Н/мм;



настройки
------------------------------------------------------------------------------------
 mr.alfa_min=  -15.0           диапазон угла атаки,  грд    //для ЭВ (малые Vx: -30; большие Vx: -10)
 mr.alfa_max=   20.0           диапазон угла атаки,  грд    //для ЭВ (малые Vx:  50; большие Vx:  20)
 mr.fi0_min=     0.0           диапазон общего шага, грд    //для ЭВ
 mr.fi0_max=    30.0           диапазон общего шага, грд    //для ЭВ
 mr.rpm_min=      10           диапазон общего шага, об/мин //для ЭВ
 mr.rpm_max=    9990           диапазон общего шага, об/мин //для ЭВ
 mr.chi_min=    -6.0 (вперед)  диапазон угла наклона АП в продольном канале, градусы (-7.5) -170mm
 mr.chi_max=     5.0 (назад )  диапазон угла наклона АП в продольном канале, градусы ( 6.5) +170mm
 mr.eta_min=    -4.0 (вправо)  диапазон угла наклона АП в поперечном канале, градусы (-5.5) -134mm
 mr.eta_max=     4.0 (влево )  диапазон угла наклона АП в поперечном канале, градусы ( 5.5) +134mm 
 mr.bet_min=    -4.5           диапазон угла взмаха, грд (-4.5*);
 mr.bet_max=    25.0           диапазон угла взмаха, грд (+25*);
 mr.ksi_min=   -15.0 (опереж)  диапазон угла качания (опережение лопасти от перпендикуляра к оси ГШ, грд  (-8*);
 mr.ksi_max=     6.0 (отстав)  диапазон угла качания (отставание лопасти от перпендикуляра к оси ГШ, грд (+15*);

 нейтральное положение лопасти - ось лопасти перпенд. оси ГШ;

