helisim.initial.tailrotor
model: PB Mи-8 с широкохордными лопастями
notes: рулевой винт : конструктивные параметры
------------------------------------------------------------------------------------

 tr.hubtype=    2               тип втулки РВ  (0=ОШ+ГШ+ВШ, 1=ОШ+ГШ, 2=ОШ+СовмГШ(качалка), 3=ОШ(бесшарнирный));
 tr.rdirect=    0               направление вращения РВ  (0-левое(против ЧС со стороны привода), 1-правое);
 tr.z=          3               кол-во лопастей РВ
 tr.Ib0=        16.5 кг*м^2     момент инерции лопасти отн.оси винта
 tr.Sb0=        11.5 кг*м       статический момент лопасти отн.оси винта
 tr.lgsh=       0.0 м           разнос ГШ
 tr.kvz=        1.000           коэф. компенсатора взмаха
 tr.dCxp=       0.002           поправка к коэф. профильного сопротивления
 tr.Bkp=        0.970           коэф. концевых потерь

 tr.xo= 	0.25	   	положение центра закрутки профиля (ОШ), мм 
 tr.xt=         0.1	   	положение центра тяжести профиля, мм	0.1-0.3
 tr.r_pov=  	105.0	 	расстояние от оси ОШ до поводка (до тяги рукава лопасти), мм
 tr.k_pov=      13600    	жесткость системы управления линейная, кН/м (rotStiff = k_pov*r_pov*r_pov;)
 tr.f_pod=      0  /0.006	 	коэф.трения в упорном подшипнике ОШ
 tr.r_pod=	50	 ~	радиус упорного подщипника ОШ, мм
 tr.sigma3=     0  /8  	 ~	коэффициент демпфирования закрутки, Н*м*с2/рад2;
 tr.mlp=        9.403    ~  	погонная масса лопасти, кг/м;  //tr.ml=  13.7 кг   масса лопасти  
 tr.Iop=        0.0464  	погонный момент инерции лопасти отн.ОШ, кг*м^2/м; 



ЛОПАСТИ
------------------------------------------------------------------------------------
