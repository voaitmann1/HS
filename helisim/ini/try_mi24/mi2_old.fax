helisim.initial.airdynamic
notes : аэродинамические характеристики планера
model : mi-2
method: 2 (формат исх.данных и соответственно алгоритм расчета: 1- универсальный; 2- по старой балансировке Ми-2)



------------------------------------------------------------------------------------

модель планера

	lmodel=	   0.760	линейный размер на модели, м;
	Smodel=	   0.012	площадь миделя модели, м2;
	Mmodel=	   16.45	масштаб модели;


аэродинамические характеристики стабилизатора (в связанной СК)

	loc=           4	закон управления стабилизатором, [1,2,3,4,5;0-постоянный угол уст.];
	est_min=   -21.0   ?	угол отклонения стабилизатора предел.вниз? (рычаг "шаг-газ" вверх) (управляемый как в Ми-2), грд;
	est_max=    -5.0   ?	угол отклонения стабилизатора предел.вверх? (рычаг "шаг-газ" вниз) (управляемый как в Ми-2), грд;
        
