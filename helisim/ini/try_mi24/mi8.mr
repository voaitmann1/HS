helisim.initial.mainrotor
model: HB Mи-8
notes: несущий винт : конструктивные параметры
------------------------------------------------------------------------------------

 mr.hubtype=    0               тип втулки НВ  (0=ОШ+ГШ+ВШ, 1=ОШ+ГШ, 2=ОШ+СовмГШ(качалка), 3=ОШ(бесшарнирный));
 mr.rdirect=    0               направление вращения НВ: 0 - против ЧС; 1 - по ЧС (по оси Yнв);
 mr.z=          5       + 	количество лопастей НВ;
 mr.Ib0=        4777.5  +!gsh   момент инерции лопасти отн. оси НВ, кг*м^2;
 mr.Sb0=        687.0   +!gsh   статический момент лопасти отн. оси НВ, кг*м; ( 681 / 691 кг*м )
 mr.lgsh=       220.0   +       разнос ГШ, мм;
 mr.lvsh=       507.0   +	разнос ВШ, мм;
 mr.svsh=       -45.0   + 	смещение ВШ (вынос горизонтального шарнира вперед), мм;
 mr.losh=       1111.0   	разнос OШ, мм;
 mr.kvz=        0.50    +       коэф. компенсатора взмаха;
 mr.dCxp=       0.001   +       поправка к коэф. профильного сопротивления;
 mr.Bkp=        0.975   +       коэф. концевых потерь;

 mr.xo= 	0.25	   	положение центра закрутки профиля (ОШ), мм 
 mr.xt=         0.28	   	положение центра тяжести профиля, мм	0.1-0.3
 /mr.stiff3=     300000  		жесткость крутильная отн.ОШ (приведенная жесткость системы управления)	
 /mr.flapStiff=	20000		жесткость изгибная в плоскости взмаха
 mr.r_pov=  	205.0	 ~	расстояние от оси ОШ до поводка (до тяги рукава лопасти), мм
 mr.k_pov=   1000   /10000 	 ~	жесткость системы управления линейная, кН/м (rotStiff = k_pov*r_pov*r_pov;)
 mr.r_pod=	140	 ~	радиус упорного подщипника ОШ, мм
 mr.f_pod=      0.006	 +	коэф.трения в упорном подшипнике ОШ
 mr.sigma3=     3000  	 ~	коэффициент демпфирования закрутки, Н*м*с2/рад2;
 mr.mlp=        15.58864588     ~  	погонная масса лопасти, кг/м;  //mr.ml=      134.0   	масса лопасти, кг (<=140);  
 mr.Iop=        0.14  	 +	погонный момент инерции лопасти отн.ОШ, кг*м^2/м;  // mr.momInerPog=	20	момент инерции погонный


АВТОМАТ ПЕРЕКОСА
             
 mr.D1=         1.75  +         передаточное отношение между углом отклонения равнодействующей и углом отклонения автомата перекоса
 mr.D2=         0.10  +         передаточное отношение между углом отклонения равнодействующей и углом отклонения автомата перекоса
 mr.Rap=        0.265 mi2       радиус крепления тяг, м;
 mr.ll=         0.157 mi2       расстояние от оси ОШ до т.крепления тяги управления к поводку, м;
 mr.dpsi_cont=  25.0  mi2       угол опережения управления, градус;



