демпфер лопасти:  damper= 0    (1: установлены демпферы, 0: не установлены)



настройки
------------------------------------------------------------------------------------
 tr.fi0_min=    -30.0           диапазон общего шага, грд  (-20.0:правая педаль до упора) //для ЭВ
 tr.fi0_max=     30.0           диапазон общего шага, грд  ( 10.0: левая педаль до упора) //для ЭВ 
 tr.rpm_min=       10           диапазон общего шага, об/мин			    //для ЭВ
 tr.rpm_max=     9990           диапазон общего шага, об/мин			    //для ЭВ
 tr.bet_min=    -10.0     	диапазон угла взмаха, грд;
 tr.bet_max=     10.0    	диапазон угла взмаха, грд;
 tr.ksi_min=    -90.0     	диапазон угла качания (предел в напр.вращения НВ), грд;
 tr.ksi_max=     90.0    	диапазон угла качания (предел против вращения НВ), грд;

