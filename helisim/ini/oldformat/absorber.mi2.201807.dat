	s.dnz=   	30       	диаметр цилиндра демпфера стенда внутренний, мм;
	s.fz=    	5        	суммарная площадь отверстий в демпфере стенда, мм^2;
	s.kz=    	100000   	жесткость пружины стенда, Н/м;

     виброгаситель несущего винта:
	vg.n=		3		количество маятников виброгасителя
	vg.m=		8		масса 1-го маятника, кг
	vg.h=		700		расстояние от оси вала НВ до центра масс маятника, мм
	vg.d=		30		диаметр роликов, мм
	vg.D=		100		диаметр сверлений, мм
	mr.Jy=		8		момент инерции вала(,...) и втулки НВ
	mr.cy=		8000000		коэффициент крутильной жесткости нагруженного участка вала НВ


винт рулевой
-----------------------------------------------------------------------------------------------
	tr.x=    	-8687.6		расстояние от начала СКС до оси рулевого винта, мм;
	tr.y=    	1709.3		расстояние от начала СКС до оси рулевого винта, мм;
	tr.z=    	445.0		расстояние от начала СКС до плоскости вращения РВ по оси Z, мм;
	tr.T=    	0 /-1070    	(Y СКРВ) тяга рулевого винта, Н;             [(+)направо]
	tr.H=    	0.0		(X СКРВ) продольная сила рулевого винта, Н;  [(+)назад]
	tr.S=    	0.0 		(Z СКРВ) поперечная сила рулевого винта, Н;  [(+)вверх]
	tr.Mx=   	0.0		продольный момент рулевого винта, Н*м;
	tr.My=   	0.0 /60		вертикальный момент рулевого винта, Н*м;
	tr.Mz=   	0.0		поперечный момент, рулевого винта, Н*м;


