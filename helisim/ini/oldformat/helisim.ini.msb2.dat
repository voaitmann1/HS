	s.fz=     5       	суммарная площадь отверстий в демпфере стенда, мм^2;
	s.kz=     100000  	жесткость пружины стенда, Н/м;

     виброгаситель несущего винта:
	vg.n=     3   		количество маятников виброгасителя
	vg.m=     8   		масса 1-го маятника, кг
	vg.h=     700 		расстояние от оси вала НВ до центра масс маятника, мм
	vg.d=     30  		диаметр роликов, мм
	vg.D=     100 		диаметр сверлений, мм
	mr.Jy=    8   		момент инерции вала(,...) и втулки НВ
	mr.cy=    8000000	коэффициент крутильной жесткости нагруженного участка вала НВ


