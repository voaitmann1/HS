helisim.initial.data.2018.06
===============================================================================================


объект
-----------------------------------------------------------------------------------------------
	model:	  МСБ-2
	notes:	  список исходных данных для HeliSim на момент изменения этого файла


настройки расчета 
-----------------------------------------------------------------------------------------------
	start=    0   		номер шага для начала/продолжения расчета (последний записанный)
	steps=    1800 /200000  число шагов расчета
	dt=       0.0001	приращение времени за один шаг, с (<=0.00001) (=1 для absorbertest)
	logstep=  10    	интервал вывода итераций (=100 - записывается каждая сотая)
	kra=      0.01  	коэф.разжатия (для баланса st.a.с1 - st.a.с2) (>=0.01)
	krp=      0.01  	коэф.разжатия (для баланса st.р - st.а) (>=0.01)
	bpa=      0.001 	точность баланса сил на пневматике и амортстойке(>=0.001)
	snlf6prc= 10.0  	точность для решателя СНЛУ 6 порядка    (>=10.0)
	snlf6lim= 1000  	предел для решателя СНЛУ 6 порядка      ( ~1000)
	snlf2prc= 0.00001 	точность для решателя СНЛУ 2 порядка (<=0.00001)
	snlf2lim= 1000   	предел для решателя СНЛУ 2 порядка      ( ~1000)
	log=      0    		вывод результатов (0 - сокращенный вывод, 1 - полный вывод)


начальные условия 
-----------------------------------------------------------------------------------------------
	Hx=       0.0  		продольное положение начала связанной СК 
	Hy=       1560 		положение по высоте  начала связанной СК 
	Hz=       0.0  		поперечное положение начала связанной СК 
	kren=     0.0  		угол крена, градус    (gama поворот связанной СК) 
	rysk=     0.0  		угол рыскания, градус ( psi поворот связанной СК) 
	tang=     0.0  		угол тангажа, градус  (teta поворот связанной СК) 
	vHx=      0.0  		продольная составляющая линейной скорости, м/с   (в земной СК)
	vHy=     -2.0  		вертикальная составляющая линейной скорости, м/с (в земной СК)
	vHz=      0.0  		боковая составляющая линейной скорости, м/с      (в земной СК)
	wHx=      0.0  		угловая скорость вертолета (оX связанной СК), рад/c
	wHy=      0.0  		угловая скорость вертолета (оY связанной СК), рад/c
	wHz=      0.0  		угловая скорость вертолета (оZ связанной СК), рад/c
	g=        9.80665 	ускорение свободного падения, м/с2;
	fix_x=    0   		ограничение перемещения по оси x (0-свободно, 1-зафиксировано)
	fix_y=    0   		ограничение перемещения по оси y (0-свободно, 1-зафиксировано)
	fix_z=    0   		ограничение перемещения по оси z (0-свободно, 1-зафиксировано)
	fix_k=    0   		ограничение крена    (поворота отн.оси x) (0-свободно, 1-зафиксировано)
	fix_r=    0   		ограничение рыскания (поворота отн.оси y) (0-свободно, 1-зафиксировано)
	fix_t=    0   		ограничение тангажа  (поворота отн.оси z) (0-свободно, 1-зафиксировано)


