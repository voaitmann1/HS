	tr.T=     0 /-1070 	(Y СКРВ) тяга рулевого винта, Н;             [(+)направо]
	tr.H=     0.0 		(X СКРВ) продольная сила рулевого винта, Н;  [(+)назад]
	tr.S=     0.0 		(Z СКРВ) поперечная сила рулевого винта, Н;  [(+)вверх]
	tr.Mx=    0.0 		продольный момент рулевого винта, Н*м;
	tr.My=    0.0 /60	вертикальный момент рулевого винта, Н*м;
	tr.Mz=    0.0 		поперечный момент, рулевого винта, Н*м;


