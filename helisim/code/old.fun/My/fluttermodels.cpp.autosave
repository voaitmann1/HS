std::vector<std::vector<double>> GetForAeroDynDeriv(double ALPHA[5][Ca][3], double MACH[5][CM][3], double _Cy[5][CM][Ca], double _Cx[5][CM][Ca], double _Mz[5][CM][Ca], double Mparam, int profileN, int ParamN_Cy1_Cx2_Mz3){
    std::vector<std::vector<double>> data;
    std::vector<double> _Cy_intrp, _Mz_intrp, _Cx_intrp, alfa_row;//alfa_for_Cyp, alfa_for_Cx, alfa_for_Mz;
    TPosInSucc Pos;
    int NGreater, NLess;
    double Mprev, Mnext, M, alfa, y;
    std::vector<double>Ms, Ys, Xprev, Xnext, Yprev, Ynext, Xpair, Ypair;
    //data.X
    for(int i=1; i<=CM; i++){
        alfa=ALPHA[profileN-1][i-1][ParamN_Cy1_Cx2_Mz3-1];
        //data.X.push_back(alfa);
        alfa_row.push_back(alfa);
    }
    data.push_back(alfa_row);
    //for data.Y
    for(int i=1; i<=CM; i++){
        M=MACH[profileN-1][i-1][ParamN_Cy1_Cx2_Mz3-1];
        Ms.push_back(M);
    }
    //data.Y
    Pos=PosInSucc(Ms, Mparam);
    if(Pos.EqualN>0){
        switch(ParamN_Cy1_Cx2_Mz3){
            case 1:
                for(int i=1; i<=Ca; i++){
                    //_Cy[5][CM][Ca]
                    y= _Cy[profileN-1][Pos.EqualN-1][i-1];
                    //data.Y.push_back(y);
                    _Cy_intrp.push_back(y);
                }
                data.push_back(_Cy_intrp);
            break;
            case 2:
                for(int i=1; i<=Ca; i++){
                    //_Cx[5][CM][Ca]
                    y= _Cx[profileN-1][Pos.EqualN-1][i-1];
                    //data.Y.push_back(y);
                    _Cx_intrp.push_back(y);
                }
                data.push_back(_Cx_intrp);
            break;
            case 3:
                for(int i=1; i<=Ca; i++){
                    //_Mz[5][CM][Ca]
                    y= _Mz[profileN-1][Pos.EqualN-1][i-1];
                    //data.Y.push_back(y);
                    _Mz_intrp.push_back(y);
                }
                data.push_back(_Mz_intrp);
            break;
        }//switch
    }else{//not equal, most likely
        if(Pos.isLess){
            NLess=1;
            NGreater=2;
        }else if(Pos.isGreater){
            NLess=CM-1;
            NGreater=CM;
        }else if(Pos.lessN>0){
            NLess=Pos.lessN;
            NGreater=Pos.lessN+1;
        }
        //
        Xpair.clear();
        //double MACH[5][CM][3]
        Xpair.push_back(MACH[profileN-1][NLess-1][ParamN_Cy1_Cx2_Mz3-1]);
        Xpair.push_back(MACH[profileN-1][NGreater-1][ParamN_Cy1_Cx2_Mz3-1]);
        switch(ParamN_Cy1_Cx2_Mz3){
            case 1:
                for(int i=1; i<=Ca; i++){
                    Ypair.clear();
                    //_Cy[5][CM][Ca]
                    y= _Cy[profileN-1][NLess-1][i-1];
                    Ypair.push_back(y);
                    y= _Cy[profileN-1][NGreater-1][i-1];
                    Ypair.push_back(y);
                    //LinInterp(std::vector<double>X, std::vector<double>Y, double x, double eps=0);
                    y=LinInterp(Xpair, Ypair, Mparam);
                    //data.Y.push_back(y);
                    _Cy_intrp.push_back(y);
                }
                data.push_back(_Cy_intrp);
            break;
            case 2:
                for(int i=1; i<=Ca; i++){
                    //_Cx[5][CM][Ca]
                    Ypair.clear();
                    y= _Cx[profileN-1][NLess-1][i-1];
                    Ypair.push_back(y);
                    y= _Cx[profileN-1][NGreater-1][i-1];
                    Ypair.push_back(y);
                    //LinInterp(std::vector<double>X, std::vector<double>Y, double x, double eps=0);
                    y=LinInterp(Xpair, Ypair, Mparam);
                    //data.Y.push_back(y);
                    _Cx_intrp.push_back(y);
                }
                data.push_back(_Cx_intrp);
            break;
            case 3:
                for(int i=1; i<=Ca; i++){
                    //_Mz[5][CM][Ca]
                    y= _Mz[profileN-1][NLess-1][i-1];
                    Ypair.push_back(y);//y= _Mz.push_back(y);
                    y= _Mz[profileN-1][NGreater-1][i-1];
                    Ypair.push_back(y);
                    //LinInterp(std::vector<double>X, std::vector<double>Y, double x, double eps=0);
                    y=LinInterp(Xpair, Ypair, Mparam);
                    //data.Y.push_back(y);
                    _Mz_intrp.push_back(y);
                }
                 data.push_back(_Mz_intrp);
            break;
        }//switch
    }
    return data;
}

double CalcAeroDynDeriv(double ALPHA[5][Ca][3], double MACH[5][CM][3], double _Cy[5][CM][Ca], double _Cx[5][CM][Ca], double _Mz[5][CM][Ca], double M, int profileN, int ParamN_Cy1_Cx2_Mz3, double alfaAsValOrMode){
    double deriv, bfc=0;
    int N1, N2;
    //TwoStdVectorsDbl pair;
    std::vector<std::vector<double>>pair;
    TPosInSucc alfaPos;
    pair=GetForAeroDynDeriv(ALPHA, MACH, _Cy, _Cx, _Mz, M, profileN, ParamN_Cy1_Cx2_Mz3);
    //if(method_MinQ1LocalDeriv2==1){
    if(fApprGT(alfaAsValOrMode, 360, 0.1) || fApprLT(alfaAsValOrMode, -360, 0.1)){//unreal alfa sn'incog'd, local deriv sn'ad calc
        //LinearApproximation(pair.X, pair.Y, deriv, bfc);
        LinearApproximation(pair[1-1], pair[2-1], deriv, bfc);
    }else{
        alfaPos=PosInSucc(pair[1-1], alfaAsValOrMode);
        if(alfaPos.isLess || alfaPos.EqualN==1){
            N1=1;
            N2=2;
        }else if(alfaPos.isGreater || alfaPos.EqualN==Ca){
            N1=Ca-1;
            N2=Ca;
        }else{
            if(alfaPos.EqualN>0){
                if(alfaPos.EqualN>0){
                    N1=alfaPos.EqualN-1;
                    N2=alfaPos.EqualN+1;
                }else if(alfaPos.lessN>0){
                    N1=alfaPos.lessN;
                    N2=alfaPos.lessN+1;
                }
            }
        }
        deriv=(pair[2-1][N2-1]-pair[2-1][N1-1])/(pair[1-1][N2-1]-pair[1-1][N1-1]);
    }
    return deriv;
}

double dADFocusDerivs(double ALPHA[5][Ca][3], double MACH[5][CM][3], double _Cy[5][CM][Ca], double _Cx[5][CM][Ca], double _Mz[5][CM][Ca], double M, int profileN){
    //CalcAeroDynDeriv(double ALPHA[5][Ca][3], double MACH[5][CM][3], double _Cy[5][CM][Ca], double _Cx[5][CM][Ca], double _Mz[5][CM][Ca], double M, int profileN, int ParamN_Cy1_Cx2_Mz3)
    double dCydAlfa=CalcAeroDynDeriv(ALPHA, MACH, _Cy, _Cx, _Mz, M, profileN, 1);
    double dMzdAlfa=CalcAeroDynDeriv(ALPHA, MACH, _Cy, _Cx, _Mz, M, profileN, 3);
    double dd=dMzdAlfa/dCydAlfa;
    return dd;
}

double FocusPosition_NotDependOnAlfa(double ALPHA[5][Ca][3], double MACH[5][CM][3], double _Cy[5][CM][Ca], double _Cx[5][CM][Ca], double _Mz[5][CM][Ca], double M, int profileN, double x_ref){
    double _xf, _xr, dd;
    //dd=dADFocusDerivs(ALPHA, MACH, _Cy, _Cx, _Mz, M, profileN);
    double dMzdAlfa=CalcAeroDynDeriv(ALPHA, MACH, _Cy, _Cx, _Mz, M, profileN, 3);
    double dCydAlfa=CalcAeroDynDeriv(ALPHA, MACH, _Cy, _Cx, _Mz, M, profileN, 1);
    dd=dMzdAlfa/dCydAlfa;
    //
    if(fApprET(dMzdAlfa, 0, 0.000001)){
        //NOp, vals s'gi'd f'focus, aly asal cases, ma qwos focus - n'ved
    }else{
        _xr=0;//efcog
        _xf=_xr-dd;
        if(fApprET(_xf, 0.25, 0.3)){ //0.3 ob typ'l vals o'_xf s'0.24..0.26
            //NOp, efcog wa ver
        }else{
            _xr=0.25;
            _xf=_xr-dd;
        }
    }
    //
    return _xf;
}

double FocusPosition_DependOnAlfa(double ALPHA[5][Ca][3], double MACH[5][CM][3], double _Cy[5][CM][Ca], double _Cx[5][CM][Ca], double _Mz[5][CM][Ca], double M, int profileN, double alfa, double x_ref){
    std::vector<double> alfaPairCy, alfaPairMz, MPairCy, MPairMz, CyPair, MzPair;
    std::vector<double> alfaCy, alfaMz, MCy, MMz;
    int alfaCyLessN, alfaCyGreaterN, alfaMzLessN, alfaMzGreaterN, MCyLessN, MCyGreaterN, MMzLessN, MMzGreaterN;
    TPosInSucc alfaCyPos, alfaMzPos, MCyPos, MMzPos;
    double _xf, _xr, CyAlfaLess, CyAlfaGreater, MzAlfaLess, MzAlfaGreater, dCy_dAlfa, dMz_dAlfa, dd, y;
    alfaCy.clear();
    for(int i=1; i<=Ca; i++){
        y=ALPHA[profileN-1][i-1][1-1];
        alfaCy.push_back(y);
    }
    alfaMz.clear();
    for(int i=1; i<=Ca; i++){
        y=ALPHA[profileN-1][i-1][3-1];
        alfaCy.push_back(y);
    }
    MCy.clear();
    for(int i=1; i<=CM; i++){
        y=MACH[profileN-1][i-1][1-1];
        MCy.push_back(y);
    }
    MMz.clear();
    for(int i=1; i<=CM; i++){
        y=MACH[profileN-1][i-1][3-1];
        MMz.push_back(y);
    }
    //PosInSucc(std::vector<double>X, double x, double eps=0);
    alfaCyPos=PosInSucc(alfaCy, alfa);
    alfaMzPos=PosInSucc(alfaMz, alfa);
    MCyPos=PosInSucc(MCy, M);
    MMzPos=PosInSucc(MMz, M);
    //
    if(alfaCyPos.EqualN==1 || alfaCyPos.lessN==1 || alfaCyPos.isLess){
        alfaCyLessN=1;
        alfaCyGreaterN=2;
    }else if(alfaCyPos.EqualN==Ca || alfaCyPos.lessN>=Ca-1 || alfaCyPos.isGreater){
        alfaCyLessN=Ca-1;
        alfaCyGreaterN=Ca;
    }else if(alfaCyPos.EqualN>0){
        alfaCyLessN=alfaCyPos.EqualN-1;
        alfaCyGreaterN=alfaCyPos.EqualN+1;
    }else{//if alfaCyPos.lessN>0
        alfaCyLessN=alfaCyPos.lessN;
        alfaCyGreaterN=alfaCyPos.lessN+1;
    }
    //
    if(alfaMzPos.EqualN==1 || alfaMzPos.lessN==1 || alfaMzPos.isLess){
        alfaMzLessN=1;
        alfaMzGreaterN=2;
    }else if(alfaMzPos.EqualN==Ca || alfaMzPos.lessN>=Ca-1 || alfaMzPos.isGreater){
        alfaMzLessN=Ca-1;
        alfaMzGreaterN=Ca;
    }else if(alfaMzPos.EqualN>0){
        alfaMzLessN=alfaMzPos.EqualN-1;
        alfaMzGreaterN=alfaMzPos.EqualN+1;
    }else{//if alfaCyPos.lessN>0
        alfaMzLessN=alfaMzPos.lessN;
        alfaMzGreaterN=alfaMzPos.lessN+1;
    }
    //
    if(MCyPos.EqualN==1 || MCyPos.lessN==1 || MCyPos.isLess){
        MCyLessN=1;
        MCyGreaterN=2;
    }else if(MCyPos.EqualN==Ca || MCyPos.lessN>=Ca-1 || MCyPos.isGreater){
        MCyLessN=Ca-1;
        MCyGreaterN=Ca;
    }else if(MCyPos.EqualN>0){
        MCyLessN=MCyPos.EqualN-1;
        MCyGreaterN=MCyPos.EqualN+1;
    }else{//if alfaCyPos.lessN>0
        MCyLessN=MCyPos.lessN;
        MCyGreaterN=MCyPos.lessN+1;
    }
    //
    if(MMzPos.EqualN==1 || MMzPos.lessN==1 || MMzPos.isLess){
        MMzLessN=1;
        MMzGreaterN=2;
    }else if(MMzPos.EqualN==Ca || MMzPos.lessN>=Ca-1 || MMzPos.isGreater){
        MMzLessN=Ca-1;
        MMzGreaterN=Ca;
    }else if(MMzPos.EqualN>0){
        MMzLessN=MMzPos.EqualN-1;
        MMzGreaterN=MMzPos.EqualN+1;
    }else{//if alfaCyPos.lessN>0
        MMzLessN=MMzPos.lessN;
        MMzGreaterN=MMzPos.lessN+1;
    }
    //
    MPairCy.clear();
    MPairCy.push_back(MACH[profileN-1][MCyLessN   -1][1-1]);
    MPairCy.push_back(MACH[profileN-1][MCyGreaterN-1][1-1]);
    // _Cy[5][CM][Ca]
    CyPair.clear();
    CyPair.push_back(_Cy[profileN-1][MCyLessN   -1][alfaCyLessN-1]);
    CyPair.push_back(_Cy[profileN-1][MCyGreaterN-1][alfaCyLessN-1]);
    //
    CyAlfaLess=LinInterp(MPairCy, CyPair, M);
    //
    MPairCy.clear();
    MPairCy.push_back(MACH[profileN-1][MCyLessN   -1][1-1]);
    MPairCy.push_back(MACH[profileN-1][MCyGreaterN-1][1-1]);
    // _Cy[5][CM][Ca]
    CyPair.clear();
    CyPair.push_back(_Cy[profileN-1][MCyLessN   -1][alfaCyGreaterN-1]);
    CyPair.push_back(_Cy[profileN-1][MCyGreaterN-1][alfaCyGreaterN-1]);
    //
    CyAlfaGreater=LinInterp(MPairCy, CyPair, M);
    //ALPHA[5][Ca][3]
    dCy_dAlfa=(CyAlfaGreater-CyAlfaLess)/(ALPHA[profileN-1][alfaCyGreaterN-1][1-1]-ALPHA[profileN-1][alfaCyLessN-1][1-1]);
    //
    //
    MPairMz.clear();
    MPairMz.push_back(MACH[profileN-1][MMzLessN   -1][3-1]);
    MPairMz.push_back(MACH[profileN-1][MMzGreaterN-1][3-1]);
    // _Cy[5][CM][Ca]
    MzPair.clear();
    MzPair.push_back(_Mz[profileN-1][MMzLessN    -1][alfaCyLessN-1]);
    MzPair.push_back(_Mz[profileN-1][MMzGreaterN-1][alfaCyLessN-1]);
    //
    MzAlfaLess=LinInterp(MPairMz, MzPair, M);
    //
    MPairMz.clear();
    MPairMz.push_back(MACH[profileN-1][MMzLessN   -1][3-1]);
    MPairMz.push_back(MACH[profileN-1][MMzGreaterN-1][3-1]);
    // _Cy[5][CM][Ca]
    MzPair.clear();
    MzPair.push_back(_Mz[profileN-1][MMzLessN    -1][alfaCyGreaterN-1]);
    MzPair.push_back(_Mz[profileN-1][MMzGreaterN-1][alfaCyGreaterN-1]);
    //
    MzAlfaGreater=LinInterp(MPairMz, MzPair, M);
    //ALPHA[5][Ca][3]
    dMz_dAlfa=(MzAlfaGreater-MzAlfaLess)/(ALPHA[profileN-1][alfaMzGreaterN-1][3-1]-ALPHA[profileN-1][alfaMzLessN-1][3-1]);
    //
    //
    dd=dMz_dAlfa/dCy_dAlfa;
    //
    //
    if(fApprET(dMz_dAlfa, 0, 0.000001)){
        //NOp, vals s'gi'd f'focus, aly asal cases, ma qwos focus - n'ved
    }else{
        _xr=0;//efcog
        _xf=_xr-dd;
        if(fApprET(_xf, 0.25, 0.3)){ //0.3 ob typ'l vals o'_xf s'0.24..0.26
            //NOp, efcog wa ver
        }else{
            _xr=0.25;
            _xf=_xr-dd;
        }
    }
    //
    return _xf;
}
double FocusPosition(double ALPHA[5][Ca][3], double MACH[5][CM][3], double _Cy[5][CM][Ca], double _Cx[5][CM][Ca], double _Mz[5][CM][Ca], double M, int profileN, double alfaAsValOrMode, double _x_ref){
    double _xf=0.25,
            dCy_dAlfa=CalcAeroDynDeriv(ALPHA, MACH, _Cy, _Cx, _Mz, M, profileN, 1, alfaAsValOrMode),
            dMz_dAlfa=CalcAeroDynDeriv(ALPHA, MACH, _Cy, _Cx, _Mz, M, profileN, 3, alfaAsValOrMode),
            dd=dMz_dAlfa/dCy_dAlfa;
    //
    if(fApprET(dMz_dAlfa, 0, 0.000001)){
        //NOp, vals s'gi'd f'focus, aly asal cases, ma qwos focus - n'ved
    }else{
        _x_ref=0;//efcog
        _xf=_x_ref - dd;
        if(fApprET(_xf, 0.25, 0.3)){ //0.3 ob typ'l vals o'_xf s'0.24..0.26
            //NOp, efcog wa ver
        }else{
            _x_ref=0.25;
            _xf=_x_ref - dd;
        }
    }
    //
    return _xf;
}

//class ThrownCorper{
//    double g;
    ThrownCorper::ThrownCorper(){
        this->g=9.81;
        //vy, vx, y, x
    }
    double ThrownCorper::Eq1RPVy(int n, double t, const double*y){
        return -1*this->g;//vy
    }
    double ThrownCorper::Eq2RPVx(int n, double t, const double*y){
        return 0;//vx
    }
    double ThrownCorper::Eq3RPY(int n, double t, const double*y){
        return y[1-1];//y
    }
    double ThrownCorper::Eq4RPX(int n, double t, const double*y){
        return y[2-1];//x
    }
    std::vector<double> ThrownCorper::Calc_ByAngle(double t, double V0, double AngleDeg, double y0, double x0, double t0, double dt){//, TValsShowHide*vsh){
        std::vector<double> q0;
        double Vy, Vx;
        //writeln(vsh, "Calc_ByAngle starts working");
        //writeln(vsh, "t="+FloatToStr(t)+" V0="+FloatToStr(V0)+" angle[deg]="+FloatToStr(AngleDeg)+" y0="+FloatToStr(y0)+" x0="+FloatToStr(x0)+" t0="+FloatToStr(t0)+" dt="+FloatToStr(dt));
        Vy=V0*sin(AngleDeg*M_PI/180);
        Vx=V0*cos(AngleDeg*M_PI/180);
        //writeln(vsh, "Vy="+FloatToStr(Vy)+" Vx="+FloatToStr(Vx)+" y0="+FloatToStr(y0)+" x0="+FloatToStr(x0));
        q0.push_back(Vy);
        q0.push_back(Vx);
        q0.push_back(y0);
        q0.push_back(x0);
        //writeln(vsh, "q0=["+FloatToStr(q0[0])+", "+FloatToStr(q0[1])+", "+FloatToStr(q0[2])+", "+FloatToStr(q0[3])+"]");
        //writeln(vsh,"going to: Calc_As1stOrderSys will start working");
        q0=this->Calc_As1stOrderSys(q0.data(), t, t0, dt);//, vsh);
        //writeln(vsh,"Calc_ByAngle finishes working");
        return q0;
    }
    // std::vector<double>            Calc_As1stOrderSys(double*q0, double t, double t0=0, double dt=1E-6);//, TValsShowHide*vsh=NULL);
    std::vector<double> ThrownCorper::Calc_As1stOrderSys(double*q0, double t, double t0,   double dt){//, TValsShowHide*vsh){
        std::vector<double>R;
        int QEq=4;
        //writeln(vsh,"Calc_As1stOrderSys sterts working");
        //writeln(vsh, "q0=["+FloatToStr(q0[0])+", "+FloatToStr(q0[1])+", "+FloatToStr(q0[2])+", "+FloatToStr(q0[3])+"]");
        //writeln(vsh, "t="+FloatToStr(t)+" t0="+FloatToStr(t0)+" dt="+FloatToStr(dt));
        using std::placeholders::_1;
        using std::placeholders::_2;
        using std::placeholders::_3;
        //

        std::vector<std::function<double(int, double, const double*)>> fArray = {
            std::bind(&ThrownCorper::Eq1RPVy, this, _1, _2, _3),
            std::bind(&ThrownCorper::Eq2RPVx, this, _1, _2, _3),
            std::bind(&ThrownCorper::Eq3RPY,  this, _1, _2, _3),
            std::bind(&ThrownCorper::Eq4RPX,  this, _1, _2, _3)
        };

        //
        //const int n = 4;
        //
        //writeln(vsh,"Going to: RungeFull will soon stert working");
        //
        R = RungeFull(4, q0, fArray, dt, t0, t);//, vsh);
        //
        //writeln(vsh,"Calc_As1stOrderSys finishes working");
        //
        return R;
    }

    //
    //void Calc_ByAngle(double*q, const TItersPrecision&ItersPrecision, double t, double V0, double AngleDeg, double y0, double x0=0, double t0=0, TValsShowHide*vsh=NULL);
    void ThrownCorper::Calc_ByAngle(double*q, const TItersPrecision&ItersPrecision, double t, double V0, double AngleDeg, double y0, double x0, double t0){//, TValsShowHide*vsh){
        double Vy, Vx;
        double dt=ItersPrecision.GetCorrectedStepLength(t0, t);
        //writeln(vsh, "Calc_ByAngle starts working");
        //writeln(vsh, "t="+FloatToStr(t)+" V0="+FloatToStr(V0)+" angle[deg]="+FloatToStr(AngleDeg)+" y0="+FloatToStr(y0)+" x0="+FloatToStr(x0)+" t0="+FloatToStr(t0)+" dt="+FloatToStr(dt));
        Vy=V0*sin(AngleDeg*M_PI/180);
        Vx=V0*cos(AngleDeg*M_PI/180);
        //writeln(vsh, "Vy="+FloatToStr(Vy)+" Vx="+FloatToStr(Vx)+" y0="+FloatToStr(y0)+" x0="+FloatToStr(x0));
        q[1-1]=Vy;
        q[2-1]=Vx;
        q[3-1]=y0;
        q[4-1]=x0;
        //writeln(vsh, "q0=["+FloatToStr(q[0])+", "+FloatToStr(q[1])+", "+FloatToStr(q[2])+", "+FloatToStr(q[3])+"]");
        //writeln(vsh,"going to: Calc_As1stOrderSys will start working");
        this->Calc_As1stOrderSys(ItersPrecision,q,  t, t0);//, vsh);
        //writeln(vsh,"Calc_ByAngle finishes working");
    }

    //void             Calc_As1stOrderSys(const TItersPrecision&ItersPrecision, double*q0, double t, double t0=0);//, TValsShowHide*vsh=NULL);
    void ThrownCorper::Calc_As1stOrderSys(const TItersPrecision&ItersPrecision, double*q, double t, double t0){//, TValsShowHide*vsh){
        std::vector<double>R;
        int QEq=4;
        //writeln(vsh,"Calc_As1stOrderSys sterts working");
        double dt=ItersPrecision.GetCorrectedStepLength(t0, t);
       // writeln(vsh, "q0=["+FloatToStr(q[0])+", "+FloatToStr(q[1])+", "+FloatToStr(q[2])+", "+FloatToStr(q[3])+"]");
       // writeln(vsh, "t="+FloatToStr(t)+" t0="+FloatToStr(t0)+" dt="+FloatToStr(dt));
        using std::placeholders::_1;
        using std::placeholders::_2;
        using std::placeholders::_3;
        //
        std::vector<std::function<double(int, double, const double*)>> fArray = {
            std::bind(&ThrownCorper::Eq1RPVy, this, _1, _2, _3),
            std::bind(&ThrownCorper::Eq2RPVx, this, _1, _2, _3),
            std::bind(&ThrownCorper::Eq3RPY,  this, _1, _2, _3),
            std::bind(&ThrownCorper::Eq4RPX,  this, _1, _2, _3)
        };
        //
        //const int n = 4;
        //
        //writeln(vsh,"Going to: RungeFull will soon stert working");
        //
        //void RungeFull_VPP_PrecCls(int Q, double*y, const std::vector<ODEFunc>&fArray, double t0, double t2, const TItersPrecision&ItersPrecision, TValsShowHide*vsh=NULL);
        RungeFull_VPP_PrecCls(4, q, fArray, t0,  t, ItersPrecision);//, vsh);
        //
       // writeln(vsh,"Calc_As1stOrderSys finishes working");
        //
        //return R;
    }
    //
    void ThrownCorper::Calc_As1stOrderSys_VPP(double*q, double t, double t0, double dt){
        using std::placeholders::_1;
        using std::placeholders::_2;
        using std::placeholders::_3;
        //
        std::vector<std::function<double(int, double, const double*)>> fArray = {
            std::bind(&ThrownCorper::Eq1RPVy, this, _1, _2, _3),
            std::bind(&ThrownCorper::Eq2RPVx, this, _1, _2, _3),
            std::bind(&ThrownCorper::Eq3RPY,  this, _1, _2, _3),
            std::bind(&ThrownCorper::Eq4RPX,  this, _1, _2, _3)
        };
        //RungeFull_VPP_PrecCls(4, q, fArray, t0,  t, ItersPrecision);//not
        //void RungeFull_VPP_PrecVal(int Q, double*y, const std::vector<ODEFunc>&fArray, double t0, double t2, double h);
        //void RungeFull_VPP_PrecVal(int Q, double*y, const std::vector<ODEFunc>&fArray, double t0, double t2, double h, TValsShowHide*vsh=NULL);
               RungeFull_VPP_PrecVal(    4,        q,                            fArray,        t0,         t,       dt);//, TValsShowHide*vsh=NULL);
    }

    void ThrownCorper::SetIniConds(double*q0, double V0, double AngleDeg, double H, double x0){
        double Vy=V0*sin(M_PI*AngleDeg/180);
        double Vx=V0*sin(M_PI*AngleDeg/180);
        //if(q0!=NULL){
        //    delete[]q0;
        //}
        //q0=new double[4];
        // Os gut f'dyn.arrr, ma owi static array. Or std::vector, ic ha var L, ma ety su L mut'tc aso
        q0[1-1]=Vy;
        q0[2-1]=Vx;
        q0[3-1]=H;
        q0[4-1]=x0;
    }

