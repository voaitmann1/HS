void Flutter_IsolatedBladeNoFriction_Data_v1_ParamsIniForCalcEquations::SetTestValues(){
    //double d11, w, c12, d12, b12, d22, p_cr, b22, c21, d21, chi_param
    this->d11=1;
    this->w=2;
    this->c12=4;
    this->d12=6;
    this->b12=8;
    this->d22=-3;
    this->p_cr=-2;
    this->b22=-4;
    this->c21=-5;
    this->d21=-6;
    this->chi_param=441.75;
}


