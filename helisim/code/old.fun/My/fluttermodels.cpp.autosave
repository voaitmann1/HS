QString FlutterModeParams::ToString(){
    QString s="", sn, sc;
    sc="fi(A)=";
    sn.setNum(this->fiAfl);
    s=s+sc;
    s=s+sn;
    s=s+" ";
    sc="p(fl)=";
    sn.setNum(this->pfl);
    s=s+sc;
    s=s+sn;
    return s;
}

