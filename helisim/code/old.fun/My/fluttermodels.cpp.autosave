void Flutter_IsolatedBladeNoFriction_Data_v1::SetIniHelicData(const Flutter_IsolatedBladeNoFriction_Data_v1_IncomingHelicParams&data){
    this->b7=data.b7;
    this->chi_param=data.chi_param;
    //this->c_ctrl=data.c_ctrl;
    //this->d_frict=data.d_frict;
    this->I_gsh=data.I_gsh;
    this->I_osh=data.I_osh;
    this->mlp=data.mlp;
    this->R=data.R;
    this->ro=data.ro;
    this->sigma=data.sigma;
    //this->sigma_f=data.sigma_f;
    this->w=data.w;
    //this->x0=data.x0;
    this->Sb0=data.Sb0;
}

void Flutter_IsolatedBladeNoFriction_Data_v1::SetIniExtData(const Flutter_IsolatedBladeNoFriction_Data_v1_IniExt&data){
    this->c_ctrl=data.c_ctrl;
    this->d_frict=data.d_frict;
    this->sigma_f=data.sigma_f;
    this->x0=data.x0;
}

void Flutter_IsolatedBladeNoFriction_Data_v1::SetBladeSupplData(const BladeParamsSupplFlutter&data){
    this->RigidityCentersLine=data.RigidityCentersLine;
    this->RigidityCentersLineTypeN=data.RigidityCentersLineTypeN;
    this->WeightCentersLine=data.WeightCentersLine;
    this->WeightCentersLineTypeN=data.WeightCentersLineTypeN;
}


void Flutter_IsolatedBladeNoFriction_Data_v1::SetHelicSupplData(const HelicParamsSupplFlutter&data){
    this->c_ctrl=data.c_ctrl;
    this->lagerR=data.lagerR;
    this->lagerKFr=data.lagerKfr;
}

void Flutter_IsolatedBladeNoFriction_Data_v1::SetFlutterModeParams(const FlutterModeParams&data){
    //this->x=data.x;
    this->fiAfl=data.fiAfl;
    this->pfl=data.pfl;
}

void Flutter_IsolatedBladeNoFriction_Data_v1::SetIncomingParams(const IncomingParamsFlutter&data){
    //this->x=data.x;
    this->b7=data.b7;
    this->chi_param=data.chi_param;
    //this->c_ctrl=data.c_ctrl;
    //this->d_frict=data.d_frict;
    this->I_gsh=data.I_gsh;
    this->I_osh=data.I_osh;
    this->mlp=data.mlp;
    this->R=data.R;
    this->ro=data.ro;
    this->sigma=data.sigma;
    //this->sigma_f=data.sigma_f;
    this->w=data.w;
    //this->x0=data.x0;
    this->Sb0=data.Sb0;//for friction!
}


void Flutter_IsolatedBladeNoFriction_Data_v1::SetIniKynemConds(std::vector<double>&IniKynemConds){//, double v1_wBeta, double v2_wFi, double v3_Beta, double v4_Fi){
    //double f_Eq1_RP_wBeta(int n, double t, const double*y);
    //double f_Eq2_RP_wFi(int n, double t, const double*y);
    //double f_Eq3_RP_Beta(int n, double t, const double*y);
    //double f_Eq4_RP_Fi(int n, double t, const double*y);
    double v1_wBeta, v2_wFi, v3_Beta, v4_Fi;
    v1_wBeta=0;
    v2_wFi=1E-6;
    v3_Beta=0;
    v4_Fi=0;
    IniKynemConds.push_back(v1_wBeta);
    IniKynemConds.push_back(v2_wFi);
    IniKynemConds.push_back(v3_Beta);
    IniKynemConds.push_back(v4_Fi);
}

//                                            Calc1_IntegrateBySects(double M_cur, double M_next, int QM,  double MACHs[5][CM][3], int QAlfas, double ALPHAs[5][Ca][3], double _Cy[5][CM][Ca], double _Cx[5][CM][Ca], double _Mz[5][CM][Ca], int QSects, const int*ProfN, const double*bh, const double*r, double _x_ref=0, TValsShowHide*vsh=NULL);
void Flutter_IsolatedBladeNoFriction_Data_v1::Calc1_IntegrateBySects(int SecN, double M_cur, double M_next, int QMs, double MACHs[5][CM][3], int QAlfas, double ALPHAs[5][Ca][3], double _Cy[5][CM][Ca], double _Cx[5][CM][Ca], double _Mz[5][CM][Ca], int QSects, const int*prof_N, const double*bh, const double*r, double _x_ref,   TValsShowHide*vsh){
    //void Calc2_char();//Cwe n'wa comment'd, et no err wa shown
    //nSec- QSects, Ca - QAlfas, CM - QMs
    double  CurVal;
    std::vector<double> r_to_chk, alfa_to_chk, M_to_chk, paramRow; //r_to_chk
    std::vector<std::vector<double>>ParamToChk;
    double b_param_cur, b_param_next;//, dCy_dalfa_cur, dCy_dalfa_next;//es ud
    int profN_cur, profN_next, N_M_prev, N_M_next;
    TPosInSucc M_Pos_cur, M_Pos_next;
    double _x_rig_cur, _x_rig_next, _x_weight_cur, _x_weight_next, _x_focus_cur, _x_focus_next, dCy_dalfa_cur, dCy_dalfa_next, dMzy_dalfa_cur, dMz_dalfa_next, rCur, rNext;
    int QAlfas_cur, QMs_cur, QAlfas_next, QMs_next;
    QString qs, qsn, qsSCur="CurSect: ", qsSNxt="NxtSect: ";
    //
    writeln(vsh, "Calc1_IntegrateBySects starts working");
    //
    i0_param = I_osh / I_gsh;
    dCy_dalfa=0;
    //
    qs="dCy/dalfa=";
    qsn.setNum(dCy_dalfa);
    qs=qs+qsn;
    qs=qs+" i0=";
    qsn.setNum(i0_param);
    qs=qs+qsn;
    writeln(vsh, qs);
    //
    qsn="";
    qs="rs: ";
    qsSCur="CurSect: ";
    qsSNxt="NxtSect: ";
    //
    this->alfas_cur.clear();
    this->alfas_next.clear();
    //
    for(int i=1; i<=QSects; i++){//nur uz iqv, n'uz calcs
        r_to_chk.push_back(r[i-1]);
        //
        qs=qs+"r[";
        qsn.setNum(i);
        qs=qs+qsn;
        qs=qs+"]=";
        qsn.setNum(r[i-1]);
        qs=qs+qsn;
        qs=qs+" ";
    }
    //
    writeln(vsh, qs);
    qs="";
    //
    //--------------1---------------------1------------------------1-----------------------
    alfa_cy_prof5_count=0;
    alfa_to_chk.clear();
    for(int i=1; i<=Ca; i++){
        alfa_to_chk.push_back(ALPHAs[5-1][i-1][1-1]);
    }
    for(int i=1; i<=Ca-2; i++){
        if(alfa_to_chk[i+1-1]==0 && alfa_to_chk[i+2-1]==0 && alfa_to_chk[i-1]!=0){
            alfa_cy_prof5_count=i;
            break;
        }
    }
    alfa_cy_prof4_count=0;
    alfa_to_chk.clear();
    for(int i=1; i<=Ca; i++){
        alfa_to_chk.push_back(ALPHAs[4-1][i-1][1-1]);
    }
    for(int i=1; i<=Ca-2; i++){
        if(alfa_to_chk[i+1-1]==0 && alfa_to_chk[i+2-1]==0 &&alfa_to_chk[i-1]!=0){
            alfa_cy_prof4_count=i;
            break;
        }
    }
    alfa_cy_prof3_count=0;
    alfa_to_chk.clear();
    for(int i=1; i<=Ca; i++){
        alfa_to_chk.push_back(ALPHAs[3-1][i-1][1-1]);
    }
    for(int i=1; i<=Ca-2; i++){
        if(alfa_to_chk[i+1-1]==0 && alfa_to_chk[i+2-1]==0 && alfa_to_chk[i-1]!=0){
            alfa_cy_prof3_count=i;
            break;
        }
    }
    alfa_cy_prof2_count=0;
    alfa_to_chk.clear();
    for(int i=1; i<=Ca; i++){
        alfa_to_chk.push_back(ALPHAs[2-1][i-1][1-1]);
    }
    for(int i=1; i<=Ca-2; i++){
        if(alfa_to_chk[i+1-1]==0 && alfa_to_chk[i+2-1]==0 && alfa_to_chk[i-1]!=0){
            alfa_cy_prof2_count=i;
            break;
        }
    }
    alfa_cy_prof1_count=0;
    alfa_to_chk.clear();
    for(int i=1; i<=Ca; i++){
        alfa_to_chk.push_back(ALPHAs[1-1][i-1][1-1]);
    }
    for(int i=1; i<=Ca-2; i++){
        if(alfa_to_chk[i+1-1]==0 && alfa_to_chk[i+2-1]==0 && alfa_to_chk[i-1]!=0){
            alfa_cy_prof1_count=i;
            break;
        }
    }
    alfa_cz_prof5_count=0;
    alfa_to_chk.clear();
    for(int i=1; i<=Ca; i++){
        alfa_to_chk.push_back(ALPHAs[5-1][i-1][3-1]);
    }
    for(int i=1; i<=Ca-2; i++){
        if(alfa_to_chk[i+1-1]==0 && alfa_to_chk[i+2-1]==0 && alfa_to_chk[i-1]!=0){
            alfa_cz_prof5_count=i;
            break;
        }
    }
    alfa_cz_prof4_count=0;
